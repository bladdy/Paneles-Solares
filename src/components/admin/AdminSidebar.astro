---
import Icon from './Icon.astro';

interface NavItem {
  label: string;
  href: string;
  icon: 'dashboard' | 'file' | 'kanban' | 'users' | 'shield' | 'settings';
  module: string;
  children?: Array<{ label: string; href: string; module: string }>;
}

interface Props {
  active?: string;
}

const { active = '' } = Astro.props;

const sections: Array<{ title: string; items: NavItem[] }> = [
  {
    title: 'Operación',
    items: [
      { label: 'Dashboard', href: '/admin/dashboard', icon: 'dashboard', module: 'dashboard' },
      { label: 'Solicitudes', href: '/admin/solicitudes', icon: 'file', module: 'solicitudes' },
      { label: 'Proyectos', href: '/admin/proyectos', icon: 'kanban', module: 'proyectos' },
    ],
  },
  {
    title: 'Gestión',
    items: [
      { label: 'Tareas', href: '/admin/tareas', icon: 'clipboard', module: 'tareas' },
      { label: 'Agenda', href: '/admin/agenda', icon: 'calendar', module: 'agenda' },
    ],
  },
  {
    title: 'Administración',
    items: [
      { label: 'Usuarios', href: '/admin/usuarios', icon: 'users', module: 'usuarios' },
      { label: 'Roles y permisos', href: '/admin/roles', icon: 'shield', module: 'roles' },
      {
        label: 'Configuración',
        href: '/admin/configuracion',
        icon: 'settings',
        module: 'configuracion',
        children: [
          { label: 'Cotizador', href: '/admin/configuracion/cotizador', module: 'configuracion' },
        ],
      },
    ],
  },
];

const isActive = (href: string) => active === href || (href !== '/admin/dashboard' && active.startsWith(href));
---

<aside
  id="admin-sidebar"
  class="fixed inset-y-0 left-0 z-[60] flex flex-col overflow-hidden bg-forest text-white"
  aria-label="Navegación administrativa"
>
  <div class="flex h-16 shrink-0 items-center gap-3 border-b border-white/10 px-5">
    <a href="/admin/dashboard" class="flex items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-solar">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-solar text-forest">
        <Icon name="sun" class="h-5 w-5" strokeWidth={2} />
      </span>
      <span class="sidebar-collapse-hide font-display text-lg font-extrabold tracking-tight">EnerSol</span>
    </a>
    <span class="sidebar-collapse-hide ml-auto rounded border border-solar/40 bg-solar/15 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-solar">
      Admin
    </span>
  </div>

  <nav class="admin-scroll flex-1 overflow-y-auto px-3 py-3">
    {
      sections.map((section) => (
        <div>
          <p class="admin-nav-group sidebar-collapse-hide">{section.title}</p>
          <ul class="space-y-1">
            {section.items.map((item) => {
              const itemActive = isActive(item.href);
              const childActive = item.children?.some((child) => active.startsWith(child.href));
              return (
                <li data-permission-module={item.module}>
                  <a
                    href={item.href}
                    class:list={['admin-nav-link', { 'admin-nav-link-active': itemActive || childActive }]}
                    aria-current={itemActive ? 'page' : undefined}
                    title={item.label}
                  >
                    <Icon name={item.icon} class="h-5 w-5 shrink-0" />
                    <span class="sidebar-collapse-hide">{item.label}</span>
                    {item.children && (
                      <Icon name="chevronDown" class="sidebar-collapse-hide ml-auto h-4 w-4 opacity-60" />
                    )}
                  </a>
                  {item.children && (
                    <ul class="sidebar-collapse-hide mt-1 space-y-0.5 pl-11">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class:list={[
                              'block rounded-md px-2 py-1.5 text-xs font-medium text-white/60 transition-colors hover:bg-white/10 hover:text-white',
                              { 'bg-white/10 text-white': active.startsWith(child.href) },
                            ]}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }

    <div class="mt-4 border-t border-white/10 pt-3">
      <a
        href="/"
        class="admin-nav-link"
        title="Ver sitio público"
      >
        <Icon name="external" class="h-5 w-5 shrink-0" />
        <span class="sidebar-collapse-hide">Ver sitio público</span>
      </a>
    </div>
  </nav>

  <div class="shrink-0 border-t border-white/10 p-3">
    <div class="sidebar-collapse-hide rounded-xl bg-white/5 p-3">
      <div class="flex items-center gap-2 text-solar">
        <Icon name="sparkles" class="h-4 w-4" />
        <p class="text-[11px] font-bold uppercase tracking-wider">Modo demostración</p>
      </div>
      <p class="mt-1.5 text-[11px] leading-relaxed text-white/55">
        Datos simulados en tu navegador. Los cambios son locales.
      </p>
    </div>
    <button
      type="button"
      data-sidebar-collapse
      class="mt-2 flex w-full items-center justify-center gap-2 rounded-lg px-3 py-2 text-xs font-medium text-white/50 transition-colors hover:bg-white/10 hover:text-white"
      aria-label="Colapsar barra lateral"
    >
      <Icon name="chevronLeft" class="h-4 w-4" />
      <span class="sidebar-collapse-hide">Colapsar menú</span>
    </button>
  </div>
</aside>

<div
  id="sidebar-backdrop"
  class="pointer-events-none fixed inset-0 z-[55] bg-charcoal/50 opacity-0 transition-opacity lg:hidden"
  aria-hidden="true"
></div>
