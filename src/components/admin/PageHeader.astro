---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}

const { title, subtitle, eyebrow } = Astro.props;
---

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="min-w-0">
    {
      eyebrow && (
        <p class="mb-1 text-[11px] font-bold uppercase tracking-[0.18em] text-solar">{eyebrow}</p>
      )
    }
    <h1 class="font-display text-2xl font-extrabold tracking-tight text-forest sm:text-[28px]">
      {title}
    </h1>
    {subtitle && <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-muted">{subtitle}</p>}
  </div>
  <div class="flex shrink-0 flex-wrap items-center gap-2">
    <slot name="actions" />
  </div>
</div>
