---
import { ICON_PATHS, type IconName } from '../../scripts/admin/icons';

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'h-5 w-5', strokeWidth = 1.8 } = Astro.props;
const raw = ICON_PATHS[name] ?? ICON_PATHS.dot;
const segments = raw.split('|');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {segments.map((segment) => <path d={segment} />)}
</svg>
