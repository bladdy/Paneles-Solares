---
import Hero from '../components/Hero.astro';
---

<section id="inicio" class="relative h-[100svh] flex items-center overflow-hidden">
  <!-- Video Background -->
  <video
    class="absolute inset-0 w-full h-full object-cover"
    autoplay
    muted
    loop
    playsinline
    
    poster="/images/solar-hero-poster.webp"
    aria-hidden="true"
  >
    <source src="/videos/solar-hero.mp4" type="video/mp4" />
    <!-- Fallback message for browsers that don't support video -->
    Tu navegador no soporta el elemento de video.
  </video>
  
  <!-- Dark Green Overlay -->
  <div class="absolute inset-0 bg-forest/70"></div>
  
  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32">
    <div class="max-w-3xl">
      <!-- Top Label -->
      <div class="inline-block mb-6">
        <span class="text-solar font-semibold text-sm tracking-wider uppercase">
          ENERGÍA INTELIGENTE · FUTURO SOSTENIBLE
        </span>
      </div>
      
      <!-- Title -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-white leading-tight mb-6">
        Convierte la energía del sol en ahorro para tu futuro.
      </h1>
      
      <!-- Description -->
      <p class="text-lg sm:text-xl text-white/90 mb-8 leading-relaxed max-w-2xl">
        Soluciones solares diseñadas para hogares y empresas que buscan optimizar su consumo eléctrico y aprovechar una energía más limpia.
      </p>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 mb-12">
        <a
          href="/solicitar-cotizacion"
          class="inline-flex items-center justify-center bg-solar text-forest px-8 py-4 rounded-lg font-semibold text-lg hover:bg-solar/90 transition-all duration-200 shadow-lg hover:shadow-xl focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
        >
          Solicitar cotización
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="#soluciones"
          class="inline-flex items-center justify-center bg-white/10 backdrop-blur-sm text-white border-2 border-white/30 px-8 py-4 rounded-lg font-semibold text-lg hover:bg-white/20 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
        >
          Conoce nuestras soluciones
        </a>
      </div>
      
      <!-- Benefits -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="flex items-start space-x-3">
          <div class="flex-shrink-0 w-10 h-10 bg-solar/20 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-solar" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-white font-semibold mb-1">Soluciones a tu medida</h3>
            <p class="text-white/80 text-sm">Diseñadas según tus necesidades</p>
          </div>
        </div>
        
        <div class="flex items-start space-x-3">
          <div class="flex-shrink-0 w-10 h-10 bg-solar/20 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-solar" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <div>
            <h3 class="text-white font-semibold mb-1">Instalación profesional</h3>
            <p class="text-white/80 text-sm">Equipo certificado y experimentado</p>
          </div>
        </div>
        
        <div class="flex items-start space-x-3">
          <div class="flex-shrink-0 w-10 h-10 bg-solar/20 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-solar" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-white font-semibold mb-1">Ahorro energético a largo plazo</h3>
            <p class="text-white/80 text-sm">Reducción en tu factura eléctrica</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Respect prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    video {
      display: none;
    }
    section {
      background: linear-gradient(rgba(18, 59, 42, 0.8), rgba(18, 59, 42, 0.8)), 
                  url('/images/solar-hero-poster.webp');
      background-size: cover;
      background-position: center;
    }
  }
</style>