---
const benefits = [
  {
    title: "Potencial de reducción del gasto eléctrico",
    description: "Disminuye tu dependencia de la red eléctrica y reduce el impacto de las tarifas.",
  },
  {
    title: "Aprovechamiento de energía renovable",
    description: "Genera electricidad limpia contribuyendo a la reducción de emisiones de carbono.",
  },
  {
    title: "Diseño adaptado al consumo",
    description: "Cada sistema se dimensiona con base en tu patrón de consumo y características del inmueble.",
  },
  {
    title: "Opciones de monitoreo energético",
    description: "Supervisa la generación y consumo de tu sistema para un mejor control energético.",
  },
  {
    title: "Posibilidad de ampliar la instalación cuando sea técnicamente viable",
    description: "Flexibilidad para crecer con tus necesidades energéticas futuras.",
  },
];
---

<section id="nosotros" class="py-20 bg-natural">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-forest mb-4">
        Beneficios de la energía solar
      </h2>
      <p class="text-lg text-charcoal/80 max-w-3xl mx-auto">
        Ventajas reales para tu hogar o empresa
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {benefits.map((benefit) => (
        <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 border border-light-green">
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-12 h-12 bg-forest/10 rounded-lg flex items-center justify-center text-forest">
              <svg class="w-6 h-6 text-forest" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-forest mb-2">
                {benefit.title}
              </h3>
              <p class="text-charcoal/80 leading-relaxed">
                {benefit.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>