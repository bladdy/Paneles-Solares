---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/admin/Icon.astro';

export function getStaticPaths() {
  const ids = Array.from({ length: 40 }, (_, index) => `PRY-2026-${String(index + 1).padStart(3, '0')}`);
  return ids.map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
---

<AdminLayout
  title={`Proyecto ${id}`}
  active="/admin/proyectos"
  breadcrumbs={[
    { label: 'Proyectos', href: '/admin/proyectos' },
    { label: id ?? 'Detalle' },
  ]}
>
  <div class="mb-5">
    <a href="/admin/proyectos" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted transition-colors hover:text-forest">
      <Icon name="arrowLeft" class="h-3.5 w-3.5" />
      Volver a proyectos
    </a>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2.5">
          <span id="project-folio" class="font-mono text-xs font-semibold text-muted">{id}</span>
          <span id="project-status-badge" class="admin-badge border-line bg-natural text-muted">Cargando…</span>
        </div>
        <h1 id="project-title" class="mt-1 font-display text-2xl font-extrabold tracking-tight text-forest sm:text-[28px]">
          Cargando proyecto…
        </h1>
        <p class="mt-1 text-sm text-muted">
          Cliente: <span id="project-client" class="font-semibold text-charcoal">—</span>
        </p>
        <div class="mt-3 flex max-w-md items-center gap-3">
          <div class="admin-progress flex-1"><div id="project-progress" class="admin-progress-bar" style="width:0%"></div></div>
          <span id="project-progress-label" class="w-10 shrink-0 text-right text-xs font-semibold text-charcoal">0%</span>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <a href="/admin/proyectos" class="admin-btn admin-btn-secondary admin-btn-sm">
          <Icon name="list" class="h-4 w-4" />
          Tablero
        </a>
        <button type="button" data-task-new class="admin-btn admin-btn-primary admin-btn-sm">
          <Icon name="plus" class="h-4 w-4" />
          Nueva tarea
        </button>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-[minmax(0,1fr)] items-start gap-4 xl:grid-cols-[minmax(0,1fr)_340px]">
    <div id="project-main" class="min-w-0 space-y-4">
      <div class="admin-card">
        <div class="admin-card-body space-y-3">
          <div class="admin-skeleton h-5 w-56"></div>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {Array.from({ length: 4 }).map(() => (
              <div class="admin-skeleton h-20 w-full"></div>
            ))}
          </div>
          <div class="admin-skeleton h-32 w-full"></div>
        </div>
      </div>
      <div class="admin-card">
        <div class="admin-card-body space-y-3">
          <div class="admin-skeleton h-5 w-40"></div>
          <div class="admin-skeleton h-24 w-full"></div>
        </div>
      </div>
    </div>

    <aside id="project-sidebar" class="min-w-0 space-y-4">
      <div class="admin-card">
        <div class="admin-card-body space-y-3">
          <div class="admin-skeleton h-5 w-32"></div>
          <div class="admin-skeleton h-10 w-full"></div>
          <div class="admin-skeleton h-10 w-full"></div>
        </div>
      </div>
      <div class="admin-card">
        <div class="admin-card-body space-y-3">
          <div class="admin-skeleton h-5 w-24"></div>
          <div class="admin-skeleton h-12 w-full"></div>
          <div class="admin-skeleton h-12 w-full"></div>
        </div>
      </div>
    </aside>
  </div>

  <script>
    import { initProjectDetail } from '../../../scripts/admin/project-detail';
    initProjectDetail();
  </script>
</AdminLayout>
