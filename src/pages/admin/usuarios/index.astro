---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../../../components/admin/PageHeader.astro';
import Icon from '../../../components/admin/Icon.astro';
import { USER_STATUS_LABEL } from '../../../utils/status';
---

<AdminLayout
  title="Usuarios"
  active="/admin/usuarios"
  breadcrumbs={[{ label: 'Usuarios' }]}
>
  <PageHeader
    eyebrow="Administración"
    title="Usuarios"
    subtitle="Gestiona al equipo, su rol y su estado de acceso en el panel de demostración."
  >
    <a slot="actions" href="/admin/roles" class="admin-btn admin-btn-secondary admin-btn-sm">
      <Icon name="shield" class="h-4 w-4" />
      Roles y permisos
    </a>
    <button slot="actions" type="button" data-new-user class="admin-btn admin-btn-primary admin-btn-sm">
      <Icon name="userPlus" class="h-4 w-4" />
      Invitar usuario
    </button>
  </PageHeader>

  <section id="users-stats" class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-5" aria-label="Resumen de usuarios">
    {Array.from({ length: 5 }).map(() => (
      <div class="admin-card p-4">
        <div class="admin-skeleton h-3 w-24"></div>
        <div class="admin-skeleton mt-2 h-7 w-12"></div>
      </div>
    ))}
  </section>

  <section class="admin-card mb-4">
    <div class="flex flex-col gap-3 border-b border-line px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
      <div id="users-filters" class="flex flex-wrap gap-1.5" aria-label="Filtrar por estado">
        <div class="admin-skeleton h-8 w-20"></div>
        <div class="admin-skeleton h-8 w-24"></div>
        <div class="admin-skeleton h-8 w-24"></div>
      </div>
      <p id="users-count" class="shrink-0 text-xs font-medium text-muted">Cargando…</p>
    </div>

    <div class="flex flex-col gap-3 p-4 lg:flex-row lg:items-center">
      <div class="relative flex-1">
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted">
          <Icon name="search" class="h-4 w-4" />
        </span>
        <input
          id="users-search"
          type="search"
          class="admin-input pl-9"
          placeholder="Buscar por nombre, correo, teléfono o puesto…"
          aria-label="Buscar usuarios"
        />
      </div>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:w-auto">
        <select id="users-role-filter" class="admin-select lg:w-48" aria-label="Rol">
          <option value="todos">Todos los roles</option>
        </select>
        <select id="users-status-filter" class="admin-select lg:w-44" aria-label="Estado">
          <option value="todos">Todos los estados</option>
          {(['activo', 'invitacion', 'suspendido'] as const).map((status) => (
            <option value={status}>{USER_STATUS_LABEL[status]}</option>
          ))}
        </select>
      </div>
    </div>
  </section>

  <section aria-label="Listado de usuarios">
    <div id="users-table" class="admin-table-wrap">
      <div class="space-y-2 p-4">
        {Array.from({ length: 6 }).map(() => (
          <div class="admin-skeleton h-14 w-full"></div>
        ))}
      </div>
    </div>

    <div id="users-pagination" class="mt-3 flex flex-col items-center justify-between gap-3 sm:flex-row" hidden>
      <p id="users-range" class="text-xs text-muted"></p>
      <div class="flex items-center gap-2">
        <button type="button" id="users-prev" class="admin-btn admin-btn-secondary admin-btn-sm">
          <Icon name="chevronLeft" class="h-3.5 w-3.5" />
          Anterior
        </button>
        <span id="users-page-label" class="text-xs font-medium text-muted"></span>
        <button type="button" id="users-next" class="admin-btn admin-btn-secondary admin-btn-sm">
          Siguiente
          <Icon name="chevronRight" class="h-3.5 w-3.5" />
        </button>
      </div>
    </div>
  </section>

  <script>
    import { initUsers } from '../../../scripts/admin/usuarios';
    initUsers();
  </script>
</AdminLayout>
