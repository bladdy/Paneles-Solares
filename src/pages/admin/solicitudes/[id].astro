---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/admin/Icon.astro';

export function getStaticPaths() {
  const ids = Array.from({ length: 40 }, (_, index) => `SOL-2026-${String(index + 1).padStart(3, '0')}`);
  return ids.map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
---

<AdminLayout
  title={`Solicitud ${id}`}
  active="/admin/solicitudes"
  breadcrumbs={[
    { label: 'Solicitudes', href: '/admin/solicitudes' },
    { label: id ?? 'Detalle' },
  ]}
>
  <div class="mb-5">
    <a href="/admin/solicitudes" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted transition-colors hover:text-forest">
      <Icon name="arrowLeft" class="h-3.5 w-3.5" />
      Volver a solicitudes
    </a>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2.5">
          <h1 id="detail-folio" class="font-mono font-display text-2xl font-extrabold tracking-tight text-forest">{id}</h1>
          <span id="detail-status" class="admin-badge border-line bg-natural text-muted">Cargando…</span>
          <span id="detail-priority-wrap" class="hidden items-center gap-1 rounded-full border border-solar/40 bg-solar-soft px-2.5 py-0.5 text-[11px] font-semibold text-forest">
            <Icon name="sparkles" class="h-3 w-3" />
            Lista para convertir
          </span>
        </div>
        <p class="mt-1 text-sm text-muted">
          <span id="detail-client" class="font-semibold text-charcoal">Cargando cliente…</span>
          <span class="mx-1.5">·</span>
          Registrada el <span id="detail-date">—</span>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <a href="/admin/solicitudes" class="admin-btn admin-btn-secondary admin-btn-sm">
          <Icon name="list" class="h-4 w-4" />
          Todas
        </a>
        <a href="/admin/proyectos" class="admin-btn admin-btn-secondary admin-btn-sm">
          <Icon name="kanban" class="h-4 w-4" />
          Proyectos
        </a>
      </div>
    </div>
  </div>

  <div class="grid items-start gap-4 xl:grid-cols-[minmax(0,1fr)_340px]">
    <div id="detail-main" class="space-y-4">
      <div class="admin-card">
        <div class="admin-card-body space-y-3">
          <div class="admin-skeleton h-5 w-48"></div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="admin-skeleton h-16 w-full"></div>
            <div class="admin-skeleton h-16 w-full"></div>
          </div>
          <div class="admin-skeleton h-40 w-full"></div>
        </div>
      </div>
      <div class="admin-card">
        <div class="admin-card-body space-y-3">
          <div class="admin-skeleton h-5 w-40"></div>
          <div class="admin-skeleton h-28 w-full"></div>
        </div>
      </div>
    </div>

    <aside id="detail-sidebar" class="space-y-4">
      <div class="admin-card">
        <div class="admin-card-body space-y-3">
          <div class="admin-skeleton h-5 w-24"></div>
          <div class="admin-skeleton h-10 w-full"></div>
          <div class="admin-skeleton h-10 w-full"></div>
        </div>
      </div>
      <div class="admin-card">
        <div class="admin-card-body space-y-3">
          <div class="admin-skeleton h-5 w-28"></div>
          <div class="admin-skeleton h-12 w-full"></div>
        </div>
      </div>
    </aside>
  </div>

  <script>
    import { initSolicitudDetail } from '../../../scripts/admin/solicitud-detalle';
    initSolicitudDetail();
  </script>
</AdminLayout>
